diff --git a/scripts/ios-build.sh b/scripts/ios-build.sh
new file mode 100644
index 0000000..8e871ac
--- /dev/null
+++ b/scripts/ios-build.sh
@@ -0,0 +1,32 @@
+#!/usr/bin/env bash
+# Produce a native device bundle. Signing is performed by the sideloading tool.
+set -euo pipefail
+cd "$(dirname "$0")/.."
+if [[ "$(uname -s)" != Darwin ]]; then
+  echo "An Apple SDK on macOS is required. Use the prepared GitHub Actions workflow." >&2
+  exit 1
+fi
+command -v cargo >/dev/null
+command -v rustup >/dev/null
+export IPHONEOS_DEPLOYMENT_TARGET=18.0
+export SDKROOT
+SDKROOT="$(xcrun --sdk iphoneos --show-sdk-path)"
+export CC_aarch64_apple_ios
+CC_aarch64_apple_ios="$(xcrun --sdk iphoneos --find clang)"
+export CFLAGS_aarch64_apple_ios="-isysroot $SDKROOT -miphoneos-version-min=18.0"
+export BINDGEN_EXTRA_CLANG_ARGS_aarch64_apple_ios="--target=arm64-apple-ios18.0 -isysroot $SDKROOT"
+rustup target add aarch64-apple-ios
+cargo build --locked --release --no-default-features -p warcraft-survivors --target aarch64-apple-ios
+stage="$(mktemp -d "${TMPDIR:-/tmp}/azeroth-ios.XXXXXX")"
+trap 'rm -rf "$stage"' EXIT
+app="$stage/Payload/AzerothSurvivors.app"
+mkdir -p "$app" ios/build
+cp target/aarch64-apple-ios/release/warcraft-survivors "$app/AzerothSurvivors"
+cp ios/Info.plist "$app/Info.plist"
+chmod 755 "$app/AzerothSurvivors"
+plutil -lint "$app/Info.plist"
+file "$app/AzerothSurvivors" | grep -q 'Mach-O 64-bit executable arm64'
+xcrun vtool -show-build "$app/AzerothSurvivors"
+# This is intentionally not called an IPA: game data must be added locally first.
+ditto -c -k --keepParent "$stage/Payload" ios/build/iphone-engine.zip
+echo "Created ios/build/iphone-engine.zip (unsigned engine; no game data)."
