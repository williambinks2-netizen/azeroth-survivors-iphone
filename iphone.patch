diff --git a/crates/benilla-app/src/survivors/mobile.rs b/crates/benilla-app/src/survivors/mobile.rs
new file mode 100644
index 0000000..e227337
--- /dev/null
+++ b/crates/benilla-app/src/survivors/mobile.rs
@@ -0,0 +1,389 @@
+//! Single-pointer touch controls for the iPhone port; opt-in on desktop for testing.
+use bevy::input::{touch::TouchPhase, InputSystems};
+use bevy::prelude::*;
+use bevy::window::PrimaryWindow;
+
+use super::{hero, hud, mobility, Phase, Run};
+
+#[derive(Resource, Default)]
+pub(super) struct MobileInput {
+    pub target: Option<Vec3>,
+    pub stick: Vec2,
+    pub look_delta: Vec2,
+    pub jump: bool,
+    pub ability: bool,
+    began_on_ui: bool,
+}
+
+#[derive(Resource, Default)]
+struct Pointer {
+    finger: Option<u64>,
+    pending: std::collections::VecDeque<TouchInput>,
+    cancelled: bool,
+}
+
+#[derive(Component, Clone, Copy)]
+enum Action { Jump, Pause, Stop }
+
+#[derive(Component)]
+struct Controls;
+
+#[derive(Resource, Default)]
+struct Gestures {
+    stick_finger: Option<u64>,
+    camera_finger: Option<u64>,
+    camera_position: Vec2,
+}
+
+#[derive(Component)]
+struct StickKnob;
+#[derive(Component)]
+struct PlayerHealth;
+#[derive(Component)]
+struct PlayerLabel;
+
+pub(super) fn plugin(app: &mut App) {
+    app.init_resource::<MobileInput>()
+        .init_resource::<Pointer>()
+        .init_resource::<Gestures>()
+        .add_systems(Startup, (controls, joystick, player_frame))
+        .add_systems(PreUpdate, gestures.after(InputSystems))
+        .add_systems(PreUpdate, pointer.after(InputSystems).before(bevy::ui::UiSystems::Focus))
+        .add_systems(Update, input.after(hero::aim_cursor).before(mobility::cast_mobility))
+        .add_systems(Update, (show_controls, draw_stick, update_player_frame).after(hud::show_panels));
+}
+
+fn player_frame(mut commands: Commands, assets: Res<AssetServer>) {
+    let font = crate::char_select::wow_font(&assets);
+    commands.spawn((Controls, Node {
+        position_type: PositionType::Absolute, left: Val::Px(12.0), top: Val::Px(10.0),
+        width: Val::Px(290.0), height: Val::Px(72.0), align_items: AlignItems::Center,
+        padding: UiRect::all(Val::Px(6.0)), column_gap: Val::Px(8.0),
+        border: UiRect::all(Val::Px(2.0)), border_radius: BorderRadius::all(Val::Px(10.0)), ..default()
+    }, BackgroundColor(Color::srgba(0.08, 0.06, 0.035, 0.9)),
+        BorderColor::all(Color::srgb(0.55, 0.45, 0.25)), GlobalZIndex(500), Visibility::Hidden,
+        bevy::ui::FocusPolicy::Pass,
+    )).with_children(|frame| {
+        frame.spawn((Node { width: Val::Px(56.0), height: Val::Px(56.0), ..default() },
+            ImageNode { color: Color::NONE, ..default() },
+            hud::UiArt::crop("Interface\\CharacterFrame\\TempPortrait", [0.0, 1.0, 0.0, 1.0])));
+        frame.spawn(Node { flex_direction: FlexDirection::Column, flex_grow: 1.0, row_gap: Val::Px(5.0), ..default() })
+            .with_children(|bar| {
+                bar.spawn((PlayerLabel, Text::new("Warrior"), TextFont { font: font.clone(), font_size: 18.0, ..default() },
+                    TextColor(Color::srgb(1.0, 0.82, 0.0))));
+                bar.spawn((Node { width: Val::Percent(100.0), height: Val::Px(15.0), border: UiRect::all(Val::Px(1.0)), ..default() },
+                    BackgroundColor(Color::BLACK), BorderColor::all(Color::srgb(0.55, 0.45, 0.25))))
+                    .with_child((PlayerHealth, Node { width: Val::Percent(100.0), height: Val::Percent(100.0), ..default() },
+                        BackgroundColor(Color::srgb(0.05, 0.7, 0.1))));
+            });
+    });
+}
+
+fn update_player_frame(run: Res<Run>, mut health: Query<&mut Node, With<PlayerHealth>>,
+    mut label: Query<&mut Text, With<PlayerLabel>>) {
+    for mut node in &mut health { node.width = Val::Percent((run.hp / run.stats().max_hp * 100.0).clamp(0.0, 100.0)); }
+    for mut text in &mut label { **text = format!("{}   Level {}", run.class.name, run.level); }
+}
+
+// Coordinates are logical pixels; the UI's 768-unit canvas is scaled to the window height.
+fn stick_center(window: &Window) -> (Vec2, f32) {
+    let scale = window.height() / 768.0;
+    (Vec2::new(130.0 * scale, window.height() - 140.0 * scale), 80.0 * scale)
+}
+
+fn stick_value(position: Vec2, center: Vec2, radius: f32) -> Vec2 {
+    let value = ((position - center) / radius.max(1.0)).clamp_length_max(1.0);
+    if value.length_squared() <= 0.01 { Vec2::ZERO } else { value }
+}
+
+fn over_controls(p: Vec2, window: &Window) -> bool {
+    let s = window.height() / 768.0;
+    p.x >= window.width() - 284.0 * s && p.y >= window.height() - 130.0 * s
+}
+
+fn gestures(
+    mut events: MessageReader<TouchInput>,
+    windows: Query<&Window, With<PrimaryWindow>>,
+    phase: Res<State<Phase>>,
+    loading: Res<crate::loading_screen::LoadingScreen>,
+    mut state: ResMut<Gestures>,
+    mut mobile: ResMut<MobileInput>,
+) {
+    mobile.look_delta = Vec2::ZERO;
+    let Ok(window) = windows.single() else { return };
+    if !window.focused || *phase.get() != Phase::Playing || loading.covering() {
+        *state = Gestures::default();
+        mobile.stick = Vec2::ZERO;
+        events.clear();
+        return;
+    }
+    let (center, radius) = stick_center(window);
+    for e in events.read() {
+        match e.phase {
+            TouchPhase::Started if state.stick_finger.is_none() && e.position.distance(center) <= radius * 1.3 => {
+                state.stick_finger = Some(e.id);
+                mobile.stick = stick_value(e.position, center, radius);
+            }
+            TouchPhase::Started if state.camera_finger.is_none() && !over_controls(e.position, window) => {
+                state.camera_finger = Some(e.id);
+                state.camera_position = e.position;
+            }
+            TouchPhase::Moved if state.stick_finger == Some(e.id) => {
+                mobile.stick = stick_value(e.position, center, radius);
+            }
+            TouchPhase::Moved if state.camera_finger == Some(e.id) => {
+                mobile.look_delta += e.position - state.camera_position;
+                state.camera_position = e.position;
+            }
+            TouchPhase::Ended | TouchPhase::Canceled => {
+                if state.stick_finger == Some(e.id) { state.stick_finger = None; mobile.stick = Vec2::ZERO; }
+                if state.camera_finger == Some(e.id) { state.camera_finger = None; }
+            }
+            _ => {}
+        }
+    }
+}
+
+fn joystick(mut commands: Commands) {
+    commands.spawn((Controls, Node {
+        position_type: PositionType::Absolute, left: Val::Px(50.0), bottom: Val::Px(60.0),
+        width: Val::Px(160.0), height: Val::Px(160.0), border: UiRect::all(Val::Px(3.0)),
+        border_radius: BorderRadius::all(Val::Percent(50.0)), ..default()
+    }, BackgroundColor(Color::srgba(0.02, 0.02, 0.02, 0.25)),
+        BorderColor::all(Color::srgba(0.9, 0.85, 0.7, 0.55)), GlobalZIndex(100), Visibility::Hidden,
+        bevy::ui::FocusPolicy::Pass,
+    )).with_child((StickKnob, Node {
+        position_type: PositionType::Absolute, left: Val::Px(52.0), top: Val::Px(52.0),
+        width: Val::Px(50.0), height: Val::Px(50.0), border: UiRect::all(Val::Px(2.0)),
+        border_radius: BorderRadius::all(Val::Percent(50.0)), ..default()
+    }, BackgroundColor(Color::srgba(0.85, 0.82, 0.72, 0.45)),
+        BorderColor::all(Color::srgba(0.95, 0.9, 0.8, 0.7)), bevy::ui::FocusPolicy::Pass));
+}
+
+fn draw_stick(mobile: Res<MobileInput>, mut knobs: Query<&mut Node, With<StickKnob>>) {
+    for mut node in &mut knobs {
+        node.left = Val::Px(52.0 + mobile.stick.x * 52.0);
+        node.top = Val::Px(52.0 + mobile.stick.y * 52.0);
+    }
+}
+
+// Keep the cursor at the lift position: the character-selection UI clicks on
+// Pressed -> Hovered. A quick tap's press and release must occupy separate frames.
+fn pointer(
+    mut events: MessageReader<TouchInput>,
+    mut state: ResMut<Pointer>,
+    mut mouse: ResMut<ButtonInput<MouseButton>>,
+    mut windows: Query<&mut Window, With<PrimaryWindow>>,
+    phase: Option<Res<State<Phase>>>,
+) {
+    state.cancelled = false;
+    state.pending.extend(events.read().copied());
+    let Ok(mut window) = windows.single_mut() else { return };
+    if !window.focused {
+        state.finger = None;
+        state.pending.clear();
+        state.cancelled = true;
+        mouse.release(MouseButton::Left);
+        window.set_cursor_position(None);
+        return;
+    }
+    while let Some(event) = state.pending.pop_front() {
+        match event.phase {
+            TouchPhase::Started if phase.as_ref().is_some_and(|p| *p.get() == Phase::Playing)
+                && !over_controls(event.position, &window) => continue,
+            TouchPhase::Started if state.finger.is_none() => {
+                state.finger = Some(event.id);
+                window.set_cursor_position(Some(event.position));
+                mouse.press(MouseButton::Left);
+                break;
+            }
+            TouchPhase::Moved if state.finger == Some(event.id) => {
+                window.set_cursor_position(Some(event.position));
+            }
+            TouchPhase::Ended | TouchPhase::Canceled if state.finger == Some(event.id) => {
+                state.finger = None;
+                state.cancelled = event.phase == TouchPhase::Canceled;
+                window.set_cursor_position(if state.cancelled { None } else { Some(event.position) });
+                mouse.release(MouseButton::Left);
+                break;
+            }
+            _ => {}
+        }
+    }
+}
+
+fn controls(mut commands: Commands, assets: Res<AssetServer>) {
+    let font = crate::char_select::wow_font(&assets);
+    commands.spawn((
+        Controls,
+        Node {
+            position_type: PositionType::Absolute,
+            right: Val::Px(28.0),
+            bottom: Val::Px(48.0),
+            column_gap: Val::Px(8.0),
+            ..default()
+        },
+        GlobalZIndex(100),
+        Visibility::Hidden,
+    )).with_children(|parent| {
+        for (action, label) in [
+            (Action::Stop, "Stop"),
+            (Action::Jump, "Jump"),
+            (Action::Pause, "Pause"),
+        ] {
+            parent.spawn((
+                Button,
+                action,
+                Node {
+                    width: Val::Px(80.0),
+                    height: Val::Px(72.0),
+                    padding: UiRect::all(Val::Px(4.0)),
+                    border: UiRect::all(Val::Px(2.0)),
+                    border_radius: BorderRadius::all(Val::Px(5.0)),
+                    align_items: AlignItems::Center,
+                    justify_content: JustifyContent::Center,
+                    ..default()
+                },
+                BackgroundColor(Color::srgba(0.10, 0.06, 0.025, 0.92)),
+                BorderColor::all(Color::srgb(0.65, 0.48, 0.22)),
+                ImageNode { color: Color::NONE, ..default() },
+                hud::UiArt::crop("Interface\\Buttons\\UI-Quickslot2", [0.0, 1.0, 0.0, 1.0]),
+            )).with_child((
+                Text::new(label),
+                TextFont { font: font.clone(), font_size: 20.0, ..default() },
+                TextColor(Color::srgb(1.0, 0.82, 0.45)),
+            ));
+        }
+    });
+}
+
+fn show_controls(
+    phase: Res<State<Phase>>,
+    mut controls: Query<&mut Visibility, With<Controls>>,
+) {
+    for mut visible in &mut controls {
+        *visible = if matches!(phase.get(), Phase::Playing | Phase::Paused) {
+            Visibility::Visible
+        } else {
+            Visibility::Hidden
+        };
+    }
+}
+
+#[allow(clippy::too_many_arguments)]
+fn input(
+    phase: Res<State<Phase>>,
+    run: Res<Run>,
+    loading: Res<crate::loading_screen::LoadingScreen>,
+    pointer: Res<Pointer>,
+    mouse: Res<ButtonInput<MouseButton>>,
+    interactions: Query<&Interaction>,
+    actions: Query<(&Action, &Interaction), Changed<Interaction>>,
+    windows: Query<&Window, With<PrimaryWindow>>,
+    mut next: ResMut<NextState<Phase>>,
+    mut mobile: ResMut<MobileInput>,
+    mut aim: ResMut<hero::AimPoint>,
+) {
+    mobile.jump = false;
+    mobile.ability = false;
+    let focused = windows.single().is_ok_and(|w| w.focused);
+    if !focused || pointer.cancelled || loading.covering() || run.dead_t.is_some() {
+        mobile.target = None;
+        mobile.began_on_ui = true;
+        if !focused && *phase.get() == Phase::Playing {
+            next.set(Phase::Paused);
+        }
+        return;
+    }
+    if *phase.get() != Phase::Playing {
+        mobile.target = None;
+        mobile.began_on_ui = true;
+    }
+    mobile.ability = *phase.get() == Phase::Playing;
+    for (action, interaction) in &actions {
+        if *interaction != Interaction::Pressed { continue; }
+        match (action, phase.get()) {
+            (Action::Jump, Phase::Playing) => mobile.jump = true,
+            (Action::Stop, _) => { mobile.target = None; mobile.stick = Vec2::ZERO; },
+            (Action::Pause, Phase::Playing) => {
+                mobile.target = None;
+                next.set(Phase::Paused);
+            }
+            (Action::Pause, Phase::Paused) => next.set(Phase::Playing),
+            _ => {}
+        }
+    }
+    if mouse.just_pressed(MouseButton::Left) {
+        mobile.began_on_ui = interactions.iter().any(|i| *i == Interaction::Pressed);
+    }
+    // Touch drags control the camera, rather than aiming a cursor at the ground.
+    aim.0 = None;
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn stick_has_a_dead_zone_and_caps_at_full_deflection() {
+        let center = Vec2::new(100.0, 100.0);
+        assert_eq!(stick_value(center + Vec2::new(1.0, 0.0), center, 50.0), Vec2::ZERO);
+        assert_eq!(stick_value(center + Vec2::new(25.0, 0.0), center, 50.0), Vec2::new(0.5, 0.0));
+        assert_eq!(stick_value(center + Vec2::new(0.0, -100.0), center, 50.0), Vec2::new(0.0, -1.0));
+    }
+
+    fn test_app() -> (App, Entity) {
+        let mut app = App::new();
+        app.add_message::<TouchInput>()
+            .init_resource::<Pointer>()
+            .init_resource::<ButtonInput<MouseButton>>()
+            .add_systems(Update, pointer);
+        let window = app.world_mut().spawn((Window::default(), PrimaryWindow)).id();
+        (app, window)
+    }
+
+    fn touch(app: &mut App, window: Entity, phase: TouchPhase) {
+        app.world_mut().write_message(TouchInput {
+            phase,
+            position: Vec2::new(120.0, 80.0),
+            window,
+            force: None,
+            id: 7,
+        });
+    }
+
+    #[test]
+    fn quick_tap_keeps_press_and_release_on_separate_frames() {
+        let (mut app, window) = test_app();
+        touch(&mut app, window, TouchPhase::Started);
+        touch(&mut app, window, TouchPhase::Ended);
+        app.update();
+        assert!(app.world().resource::<ButtonInput<MouseButton>>().pressed(MouseButton::Left));
+        app.update();
+        assert!(!app.world().resource::<ButtonInput<MouseButton>>().pressed(MouseButton::Left));
+        assert_eq!(app.world().get::<Window>(window).unwrap().cursor_position(), Some(Vec2::new(120.0, 80.0)));
+    }
+
+    #[test]
+    fn cancelled_touch_cannot_release_over_a_menu_button() {
+        let (mut app, window) = test_app();
+        touch(&mut app, window, TouchPhase::Started);
+        app.update();
+        touch(&mut app, window, TouchPhase::Canceled);
+        app.update();
+        assert!(app.world().resource::<Pointer>().cancelled);
+        assert!(!app.world().resource::<ButtonInput<MouseButton>>().pressed(MouseButton::Left));
+        assert_eq!(app.world().get::<Window>(window).unwrap().cursor_position(), None);
+    }
+
+    #[test]
+    fn backgrounding_releases_the_pointer() {
+        let (mut app, window) = test_app();
+        touch(&mut app, window, TouchPhase::Started);
+        app.update();
+        app.world_mut().get_mut::<Window>(window).unwrap().focused = false;
+        app.update();
+        assert!(app.world().resource::<Pointer>().cancelled);
+        assert!(!app.world().resource::<ButtonInput<MouseButton>>().pressed(MouseButton::Left));
+    }
+}
